{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>crxig-rxberts/renovate-config#0.4.55"],
  "packageRules": [
    {
      "description": "Require review for privileged workflow updates",
      "matchManagers": ["github-actions"],
      "automerge": false,
      "autoApprove": false
    },
    {
      "description": "Require review for Terraform dependency updates",
      "matchManagers": ["terraform"],
      "automerge": false,
      "autoApprove": false
    }
  ]
}
